{
  "name": "aimlinterviews-mcp",
  "version": "0.1.2",
  "description": "MCP server that turns AI assistants into spoiler-safe AI/ML interview tutors using the AIMLInterviews curriculum",
  "type": "module",
  "bin": {
    "aimlinterviews-mcp": "dist/src/index.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    }
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js test/research.test.mjs",
    "prepack": "npm test",
    "inspect": "npx @modelcontextprotocol/inspector node dist/src/index.js",
    "research": "node examples/research.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-interview",
    "machine-learning",
    "interview-prep",
    "ai-tutor",
    "genai",
    "pytorch"
  ],
  "author": "Alireza Dirafzoon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alirezadir/AIMLInterviews.git",
    "directory": "MCP"
  },
  "homepage": "https://github.com/alirezadir/AIMLInterviews/tree/main/MCP#readme",
  "bugs": {
    "url": "https://github.com/alirezadir/AIMLInterviews/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
